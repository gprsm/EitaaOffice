#!/usr/bin/env bash
set -Eeuo pipefail

app=eitaa-bridge
root=/srv/projects/$app
inbox=/srv/deploy-inbox/$app
artifact=$inbox/release.tar.gz
checksum_file=$inbox/release.sha256
service=eitaa-bridge.service

check_release_ready() {
    curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:8876/api/v1/readiness >/dev/null &&
    curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:8876/api/v2/app-auth/status |
        python3 -c 'import json,sys; p=json.load(sys.stdin); sys.exit(0 if p.get("ok") is True and p.get("enabled") is True and p.get("authenticated") is False else 1)'
}

status() {
    printf 'site=%s\n' "$app"
    printf 'current=%s\n' "$(readlink -f "$root/current" 2>/dev/null || true)"
    systemctl is-active "$service" || true
    check_release_ready
}

[[ ${1:-} == "status" ]] && { status; exit 0; }
[[ ${1:-} == "deploy" ]] || exit 2

exec 9>/run/lock/publish-$app.lock
flock -n 9 || { echo "publish-site: another deployment is running" >&2; exit 1; }

[[ -f "$artifact" && -f "$checksum_file" ]] || {
    echo "publish-site: upload release.tar.gz and release.sha256 to $inbox" >&2
    exit 1
}
expected=$(awk 'NR==1 {print $1}' "$checksum_file")
[[ "$expected" =~ ^[0-9a-fA-F]{64}$ ]] || {
    echo "publish-site: invalid checksum file" >&2
    exit 1
}
actual=$(sha256sum "$artifact" | awk '{print $1}')
[[ "${expected,,}" == "$actual" ]] || {
    echo "publish-site: artifact checksum mismatch" >&2
    exit 1
}

release_id="$(date -u +%Y%m%dT%H%M%SZ)-${actual:0:12}"
release="$root/releases/$release_id"
[[ ! -e "$release" ]] || {
    echo "publish-site: release already exists: $release_id" >&2
    exit 1
}
install -d -m 0750 -o root -g eitaa-bridge "$release"
tar -xzf "$artifact" -C "$release" --no-same-owner --no-same-permissions
[[ -f "$release/pyproject.toml" && -f "$release/ui/dist/index.html" ]] || {
    echo "publish-site: release is incomplete" >&2
    exit 1
}

python3 -m venv "$release/.venv"
"$release/.venv/bin/python" -m pip install --disable-pip-version-check \
    --find-links "$release/vendor" "$release"
"$release/.venv/bin/python" -c 'import eitaa_bridge; import cryptography; import requests'

chown -R root:eitaa-bridge "$release"
find "$release" -type d -exec chmod g-w,o-rwx {} +
find "$release" -type f -exec chmod g-w,o-rwx {} +

old_target=""
if [[ -L "$root/current" ]]; then
    old_target=$(readlink -f "$root/current" 2>/dev/null || true)
fi
ln -s "$release" "$root/current.next"
mv -Tf "$root/current.next" "$root/current"

if ! systemctl restart "$service"; then
    if [[ -n "$old_target" ]]; then
        ln -s "$old_target" "$root/current.rollback"
        mv -Tf "$root/current.rollback" "$root/current"
        systemctl restart "$service" || true
    else
        rm -f -- "$root/current"
    fi
    echo "publish-site: service restart failed; previous release restored" >&2
    exit 1
fi

ready=0
for _ in $(seq 1 30); do
    if check_release_ready; then
        ready=1
        break
    fi
    sleep 1
done
if [[ "$ready" != 1 ]]; then
    journalctl -u "$service" -n 40 --no-pager >&2 || true
    if [[ -n "$old_target" ]]; then
        ln -s "$old_target" "$root/current.rollback"
        mv -Tf "$root/current.rollback" "$root/current"
        systemctl restart "$service" || true
    else
        rm -f -- "$root/current"
    fi
    echo "publish-site: readiness or browser authentication failed; previous release restored" >&2
    exit 1
fi

install -d -m 0750 -o root -g eitaa-bridge "$root/receipts"
printf '%s  %s\n' "$actual" "$release_id" > "$root/receipts/$release_id.sha256"
chmod 0640 "$root/receipts/$release_id.sha256"
echo "publish-site: deployed $app release $release_id"
