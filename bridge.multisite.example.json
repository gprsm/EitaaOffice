{
  "schema_version": 1,
  "default_site_key": "site-one",
  "bridge": {
    "diagnostics_root": "diagnostics/bridge",
    "diagnostics_enabled": true,
    "composition_state_file": "data/bridge_compositions.json"
  },
  "core": {
    "session_file": ".eitaa_session.json",
    "database_file": "data/eitaa_messages.sqlite3",
    "media_directory": "data/media",
    "diagnostics_root": "diagnostics/core",
    "diagnostics_enabled": true,
    "timeout_seconds": 30.0
  },
  "wordpress_sites": [
    {
      "site_key": "site-one",
      "base_url": "https://site-one.example.com",
      "default_status": "draft",
      "default_category_id": null,
      "timeout_seconds": 30.0,
      "verify_tls": true,
      "retry_attempts": 2,
      "username_env": "EITAA_BRIDGE_WP_SITE_ONE_USERNAME",
      "application_password_env": "EITAA_BRIDGE_WP_SITE_ONE_APP_PASSWORD"
    },
    {
      "site_key": "site-two",
      "base_url": "https://site-two.example.com",
      "default_status": "draft",
      "default_category_id": null,
      "timeout_seconds": 30.0,
      "verify_tls": true,
      "retry_attempts": 2,
      "username_env": "EITAA_BRIDGE_WP_SITE_TWO_USERNAME",
      "application_password_env": "EITAA_BRIDGE_WP_SITE_TWO_APP_PASSWORD"
    }
  ]
}
