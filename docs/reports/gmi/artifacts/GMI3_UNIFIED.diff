+                self._contact_import_cancellations.pop(job_id, None)
+
+    def _contact_import_status(self, query: Mapping[str, Any]) -> dict[str, Any]:
+        job_id = str(query.get("job_id") or "").strip()
+        with self._contact_import_lock:
