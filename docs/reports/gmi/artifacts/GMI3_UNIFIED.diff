+print(f"MISMATCHES={len(mismatches)}")
+print(f"MISSING={len(missing)}")
+for item in mismatches:
+    print(f"CHANGED {item}")
+for item in missing:
+    print(f"MISSING {item}")
+sys.exit(1 if mismatches or missing else 0)
