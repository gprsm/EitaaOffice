+"""Compare frozen GMI2 assets directly against the signed clean base ZIP."""
+
+from __future__ import annotations
+
+from hashlib import sha256
+from pathlib import Path
+import sys
+import zipfile
+
+
+ROOT = Path(__file__).resolve().parents[1]
+BASE_ZIP = ROOT.parents[1] / "MVP6_1_1_GMI2" / "artifacts" / "eitaa_bridge_v0_7_ui_mvp6_1_1_gmi2_local_index_filters_WORKING.zip"
