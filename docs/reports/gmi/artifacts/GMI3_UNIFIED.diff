+
+    def _contact_import_cancel(self, payload: Mapping[str, Any]) -> dict[str, Any]:
+        job_id = str(payload.get("job_id") or "").strip()
+        with self._contact_import_lock:
+            job = self._contact_import_jobs.get(job_id)
