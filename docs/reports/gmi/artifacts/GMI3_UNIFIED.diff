+            if cancellation is not None and job["state"] in {"queued", "running"}:
+                cancellation.set()
+                job["state"] = "cancelling"
+            copied = dict(job)
+            copied["progress"] = dict(job["progress"])
+            return {"ok": True, "job": copied}
+
